    {
      "id": "node-process-review",
      "name": "处理审查结果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [2700, 400],
      "parameters": {
        "jsCode": "// 处理审查结果并决定是否批准代码\nconst response = $input.first().json;\nlet reviewFeedback = '';\nlet approved = false;\n\n// 从不同的API响应格式中提取审查反馈\nif (response.choices && response.choices[0]) {\n  reviewFeedback = response.choices[0].message.content;\n} else if (response.reply) {\n  reviewFeedback = response.reply;\n} else if (response.text) {\n  reviewFeedback = response.text;\n}\n\n// 检查代码是否被批准\nif (reviewFeedback.toUpperCase().includes('APPROVED')) {\n  approved = true;\n}\n\nreturn {\n  json: {\n    generated_code: $json.generated_code,\n    review_feedback: reviewFeedback,\n    code_approved: approved,\n    current_loop: $json.current_loop,\n    max_loops: $json.max_loops,\n    goal: $json.goal,\n    repo_owner: $json.repo_owner,\n    repo_name: $json.repo_name,\n    output_path: $json.output_path,\n    branch: $json.branch\n  }\n};"
      },
      "notes": "分析审查反馈并确定是否批准代码",
      "notesInFlow": true,
      "color": "#2C3E50"
    },
    {
      "id": "node-approval-check",
      "name": "代码批准检查",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2900, 400],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.code_approved }}",
              "value2": true
            }
          ]
        }
      },
      "notes": "检查代码是否已被批准以继续提交",
      "notesInFlow": true,
      "color": "#27AE60"
    },
    {
      "id": "node-github-commit",
