      "notesInFlow": true,
      "color": "#C0392B"
    },
    {
      "id": "node-merge-reviewer",
      "name": "合并审查结果",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [2500, 400],
      "parameters": {
        "mode": "combine",
        "mergeByFields": {
          "values": []
        },
        "options": {}
      },
      "notes": "合并主审查器和备用审查器的输出",
