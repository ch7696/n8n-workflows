            },
            {
              "name": "messages",
              "value": "={{ [{ \"role\": \"system\", \"content\": \"你是一个专业的代码审查专家。请审查以下代码的质量、安全性和最佳实践。如果代码符合标准，请回复'APPROVED'，否则提供详细的改进建议。\" }, { \"role\": \"user\", \"content\": \"目标: \" + $json.goal + \"\\n\\n生成的代码:\\n\" + $json.generated_code }] }}"
            },
            {
              "name": "temperature",
              "value": 0.3
            }
          ]
        },
        "options": {
