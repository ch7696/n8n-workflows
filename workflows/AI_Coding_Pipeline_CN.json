      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [3100, 300],
      "parameters": {
        "resource": "file",
        "operation": "create",
        "owner": "={{ $json.repo_owner }}",
        "repository": "={{ $json.repo_name }}",
        "filePath": "={{ $json.output_path }}",
        "fileContent": "={{ $json.generated_code }}",
        "commitMessage": "=由AI编码流水线生成: {{ $json.goal }}",
        "additionalParameters": {
          "branch": "={{ $json.branch }}"
        }
      },
      "credentials": {
        "githubOAuth2Api": {
          "id": "githubOAuth2Api",
          "name": "GitHub OAuth2"
        }
      },
      "notes": "将生成的代码提交到GitHub仓库 ch7696/n8n-workflows",
      "notesInFlow": true,
      "color": "#F39C12"
    },
    {
      "id": "node-success-message",
      "name": "成功消息",
