{
  "name": "生产级AI编码流水线",
  "nodes": [
    {
      "id": "node-manual-trigger",
      "name": "手动触发",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [100, 300],
      "parameters": {}
    },
    {
      "id": "node-global-config",
      "name": "全局配置",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [300, 300],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "goal",
              "value": "创建一个Python函数来处理用户输入"
            },
            {
              "name": "repo_owner",
              "value": "ch7696"
            },
            {
              "name": "repo_name",
              "value": "n8n-workflows"
            },
            {
              "name": "output_path",
              "value": "output/generated_code.py"
            },
            {
              "name": "branch",
              "value": "main"
            }
          ],
          "number": [
            {
              "name": "max_loops",
              "value": 3
            },
            {
              "name": "current_loop",
              "value": 0
            }
          ],
          "boolean": [
            {
              "name": "code_approved",
              "value": false
            }
          ]
        },
        "options": {}
      },
      "notes": "设置工作流的全局参数：最大循环次数、目标、仓库信息等",
      "notesInFlow": true,
      "color": "#FF6B6B"
    },
    {
      "id": "node-loop-controller",
      "name": "循环控制器",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [500, 300],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.code_approved }}",
              "value2": true
            }
          ],
          "number": [
            {
              "value1": "={{ $json.current_loop }}",
              "operation": "smaller",
              "value2": "={{ $json.max_loops }}"
            }
          ]
        },
        "combineOperation": "any"
      },
      "notes": "检查代码是否已批准或是否达到最大循环次数",
      "notesInFlow": true,
      "color": "#9B59B6"
    },
    {
      "id": "node-increment-loop",
      "name": "增加循环计数",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [700, 400],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "current_loop",
              "value": "={{ $json.current_loop + 1 }}"
            }
          ]
        },
        "options": {
          "dotNotation": false
        }
      },
      "notes": "增加当前循环计数器",
      "notesInFlow": true,
      "color": "#3498DB"
    },
    {
      "id": "node-primary-coder",
      "name": "主编码代理(DeepSeek)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [900, 400],
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "deepseekApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "deepseek-coder"
            },
            {
              "name": "messages",
              "value": "={{ [{ \"role\": \"system\", \"content\": \"你是一个专业的Python代码生成专家。请根据用户需求生成高质量、可维护的代码。\" }, { \"role\": \"user\", \"content\": $json.goal }] }}"
            },
            {
              "name": "temperature",
              "value": 0.7
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "notes": "使用DeepSeek API生成代码",
      "notesInFlow": true,
      "color": "#1ABC9C",
      "continueOnFail": true
    },
    {
      "id": "node-coder-failover",
      "name": "编码器故障转移检查",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1100, 400],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.error }}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "notes": "检查主编码器是否成功，失败则使用备用编码器",
      "notesInFlow": true,
      "color": "#E67E22"
    },
    {
      "id": "node-fallback-coder",
      "name": "备用编码代理(Minimax)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1300, 500],
      "parameters": {
        "method": "POST",
        "url": "https://api.minimax.chat/v1/text/chatcompletion_v2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "minimaxApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "abab6.5-chat"
            },
            {
              "name": "messages",
              "value": "={{ [{ \"role\": \"system\", \"content\": \"你是一个专业的Python代码生成专家。请根据用户需求生成高质量、可维护的代码。\" }, { \"role\": \"user\", \"content\": $json.goal }] }}"
            },
            {
              "name": "temperature",
              "value": 0.7
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "notes": "使用Minimax API作为备用编码器",
      "notesInFlow": true,
      "color": "#16A085"
    },
    {
      "id": "node-merge-coder",
      "name": "合并编码结果",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [1500, 400],
      "parameters": {
        "mode": "combine",
        "mergeByFields": {
          "values": []
        },
        "options": {}
      },
      "notes": "合并主编码器和备用编码器的输出",
      "notesInFlow": true,
      "color": "#95A5A6"
    },
    {
      "id": "node-extract-code",
      "name": "提取生成的代码",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1700, 400],
      "parameters": {
        "jsCode": "// 从AI响应中提取代码\nconst response = $input.first().json;\nlet generatedCode = '';\n\n// 尝试从不同的API响应格式中提取代码\nif (response.choices && response.choices[0]) {\n  generatedCode = response.choices[0].message.content;\n} else if (response.reply) {\n  generatedCode = response.reply;\n} else if (response.text) {\n  generatedCode = response.text;\n}\n\n// 提取代码块（如果被markdown包裹）\nconst codeBlockMatch = generatedCode.match(/```(?:python)?\\n([\\s\\S]*?)\\n```/);\nif (codeBlockMatch) {\n  generatedCode = codeBlockMatch[1];\n}\n\nreturn {\n  json: {\n    generated_code: generatedCode.trim(),\n    goal: $json.goal,\n    current_loop: $json.current_loop,\n    max_loops: $json.max_loops,\n    repo_owner: $json.repo_owner,\n    repo_name: $json.repo_name,\n    output_path: $json.output_path,\n    branch: $json.branch\n  }\n};"
      },
      "notes": "从AI响应中提取并清理生成的代码",
      "notesInFlow": true,
      "color": "#34495E"
    },
    {
      "id": "node-primary-reviewer",
      "name": "主审查代理(Volcengine)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1900, 400],
      "parameters": {
        "method": "POST",
        "url": "https://ark.cn-beijing.volces.com/api/v3/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "volcengineApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "ep-20241228153526-xpfx5"
            },
            {
              "name": "messages",
              "value": "={{ [{ \"role\": \"system\", \"content\": \"你是一个专业的代码审查专家。请审查以下代码的质量、安全性和最佳实践。如果代码符合标准，请回复'APPROVED'，否则提供详细的改进建议。\" }, { \"role\": \"user\", \"content\": \"目标: \" + $json.goal + \"\\n\\n生成的代码:\\n\" + $json.generated_code }] }}"
            },
            {
              "name": "temperature",
              "value": 0.3
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "notes": "使用Volcengine API审查生成的代码",
      "notesInFlow": true,
      "color": "#8E44AD",
      "continueOnFail": true
    },
    {
      "id": "node-reviewer-failover",
      "name": "审查器故障转移检查",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2100, 400],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.error }}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "notes": "检查主审查器是否成功，失败则使用备用审查器",
      "notesInFlow": true,
      "color": "#E74C3C"
    },
    {
      "id": "node-fallback-reviewer",
      "name": "备用审查代理(DeepSeek)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2300, 500],
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "deepseekApi",
